<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity
        name="Domain\Model\Member"
        repository-class="Infrastructure\Doctrine\Repository\MemberRepository"
        table="member"
    >

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="email" column="email" type="string" length="180" nullable="false" unique="true" />
        <field name="roles" column="roles" type="json" />
        <field name="password" column="password" type="string" length="255" nullable="false" unique="false" />

        <one-to-one
            field="participant"
            target-entity="Domain\Model\Participant"
            inversed-by="member" >
                <cascade>
                    <cascade-persist/>
                    <cascade-remove/>
                </cascade>
        </one-to-one>

        <one-to-many
            field="memberships"
            target-entity="Domain\Model\GroupMembership"
            mapped-by="member" >
                <cascade>
                    <cascade-persist/>
                    <cascade-remove/>
                </cascade>
        </one-to-many>

    </entity>

</doctrine-mapping>
