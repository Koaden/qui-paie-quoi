{% props
    title = '',
    template,
    parameters = [],
    id = 'modal',
    profile = false
%}

<div class="modal hidden {{ profile? 'modal--profile' : '' }}" id="{{ id }}">
    <div class="modal__card">
        <div class="modal__header">
            <span class="modal__title">{{ title }}</span>
            <button class="modal__close btn" data-modal-close="{{ id }}"></button>
        </div>
        <div class="modal__body">
            {{ include(template, parameters) }}
        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const modal = document.getElementById('{{ id }}');
        const openButtons = document.querySelectorAll('[data-modal-open="{{ id }}"]');
        const closeElements = modal.querySelectorAll('[data-modal-close="{{ id }}"]');

        function openModal(modal) {
            modal.classList.remove('hidden');
            modal.setAttribute('aria-hidden', 'false');
        }

        function closeModal(modal) {
            modal.classList.add('hidden');
            modal.setAttribute('aria-hidden', 'true');
        }

        openButtons.forEach(button => {
            button.addEventListener('click', () => openModal(modal));
        });

        closeElements.forEach(el => {
            el.addEventListener('click', () => closeModal(modal));
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === "Escape" && !modal.classList.contains('hidden')) {
                closeModal(modal);
            }
        });

        modal.addEventListener('click', (e) => {
            const isClickInside = modal.querySelector('.modal__card').contains(e.target);
            if (!isClickInside) {
                closeModal(modal);
            }
        });
    });
</script>
