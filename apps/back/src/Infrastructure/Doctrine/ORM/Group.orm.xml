<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity
        name="Domain\Model\Group"
        repository-class="Infrastructure\Doctrine\Repository\GroupRepository"
        table="expense_group"
    >

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="name" column="name" type="string" length="100" nullable="false" unique="false" />

        <field name="description" column="description" type="text" nullable="true" unique="false" />

        <many-to-one field="owner" target-entity="Domain\Model\Member">
            <cascade>
                <cascade-persist/>
            </cascade>
            <join-column name="owner_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <many-to-many
            field="participants"
            target-entity="Domain\Model\Participant"
            inversed-by="group"
            orphan-removal="true">
                <cascade>
                    <cascade-persist/>
                </cascade>
        </many-to-many>

        <one-to-many
            field="expenses"
            target-entity="Domain\Model\Expense"
            mapped-by="group">
            <cascade>
                <cascade-persist/>
            </cascade>
        </one-to-many>

        <one-to-many
            field="invitations"
            target-entity="Domain\Model\Invitation"
            mapped-by="group">
            <cascade>
                <cascade-persist/>
            </cascade>
        </one-to-many>

    </entity>

</doctrine-mapping>
