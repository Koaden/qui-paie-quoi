<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity
        name="Domain\Model\Invitation"
        repository-class="Infrastructure\Doctrine\Repository\InvitationRepository"
        table="invitation"
    >

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="code" column="code" type="string" length="14" nullable="false" unique="true" />

        <many-to-one
            field="participant"
            target-entity="Domain\Model\Participant" >
                <join-column name="participant_id" referenced-column-name="id" nullable="false" />
        </many-to-one>

        <many-to-one
            field="group"
            target-entity="Domain\Model\Group"
            inversed-by="invitations" >
                <join-column name="group_id" referenced-column-name="id" nullable="false" />
        </many-to-one>

    </entity>

</doctrine-mapping>
