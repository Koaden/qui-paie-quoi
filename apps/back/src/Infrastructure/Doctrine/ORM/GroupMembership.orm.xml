<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity
        name="Domain\Model\GroupMembership"
        repository-class="Infrastructure\Doctrine\Repository\GroupMembershipRepository"
        table="group_membership"
    >

        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <many-to-one
            field="member"
            target-entity="Domain\Model\Member"
            inversed-by="memberships"
        >
            <join-column
                name="member_id"
                referenced-column-name="id"
                nullable="false"
                on-delete="CASCADE"
            />
        </many-to-one>

        <many-to-one
            field="group"
            target-entity="Domain\Model\Group"
        >
            <join-column
                name="group_id"
                referenced-column-name="id"
                nullable="false"
                on-delete="CASCADE"
            />
        </many-to-one>

        <field
            name="role"
            type="string"
            length="10"
            enum-type="Domain\Enum\GroupRole"
        />

        <unique-constraints>
            <unique-constraint
                columns="member_id,group_id"
            />
        </unique-constraints>

    </entity>

</doctrine-mapping>
