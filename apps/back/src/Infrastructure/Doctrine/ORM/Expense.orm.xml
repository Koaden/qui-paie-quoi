<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity
        name="Domain\Model\Expense"
        repository-class="Infrastructure\Doctrine\Repository\ExpenseRepository"
        table="expense"
    >

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="title" column="title" type="string" length="100" nullable="false" unique="false" />

        <field name="amount" column="amount" type="integer" nullable="false" />

        <field name="date" column="date" type="datetime" nullable="false" />

        <many-to-one
            field="payer"
            target-entity="Domain\Model\Participant" >
                <join-column name="payer_id" referenced-column-name="id" nullable="false" />
        </many-to-one>

        <many-to-one
            field="creator"
            target-entity="Domain\Model\Member" >
                <join-column name="creator_id" referenced-column-name="id" nullable="false" />
        </many-to-one>

        <many-to-many
            field="beneficiaries"
            target-entity="Domain\Model\Participant"
            inversed-by="expenses"/>

        <many-to-one
            field="group"
            target-entity="Domain\Model\Group"
            inversed-by="expenses">
                <join-column name="group_id" referenced-column-name="id" nullable="false" />
        </many-to-one>
    </entity>

</doctrine-mapping>
